-- settings 域 v1 schema（设计文档 §11.3）
-- 生成类：SettingsDb / SettingsQueries

CREATE TABLE settings_profile (
  id         TEXT    NOT NULL PRIMARY KEY,
  name       TEXT,
  active     INTEGER NOT NULL DEFAULT 0,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE settings_pref (
  id          TEXT    NOT NULL PRIMARY KEY,
  profile_id  TEXT,
  key         TEXT    NOT NULL,
  type        TEXT    NOT NULL,
  string_val  TEXT,
  int_val     INTEGER,
  bool_val    INTEGER,
  json_val    TEXT,
  updated_at  INTEGER NOT NULL,
  UNIQUE (profile_id, key)
);

-- ── queries ──
insertProfile:
INSERT INTO settings_profile (id, name, active, created_at, updated_at)
VALUES (?, ?, ?, ?, ?);

clearActiveProfile:
UPDATE settings_profile SET active = 0;

setActiveProfile:
UPDATE settings_profile SET active = ? WHERE id = ?;

selectAllProfiles:
SELECT * FROM settings_profile ORDER BY updated_at DESC;

insertPref:
INSERT INTO settings_pref (id, profile_id, key, type, string_val, int_val, bool_val, json_val, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- upsertPref：INSERT OR REPLACE（兼容 targetSdk=28 的 SQLite 3.22；UNIQUE(profile_id,key) 冲突时删旧插新）。
upsertPref:
INSERT OR REPLACE INTO settings_pref (id, profile_id, key, type, string_val, int_val, bool_val, json_val, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectPref:
SELECT * FROM settings_pref WHERE profile_id IS ? AND key = ?;

selectAllPrefs:
SELECT * FROM settings_pref WHERE profile_id IS ?;

deletePref:
DELETE FROM settings_pref WHERE profile_id IS ? AND key = ?;

-- ── 旧 Room settings 域补表（阶段 1）──

CREATE TABLE ai_providers (
  id               TEXT    NOT NULL PRIMARY KEY,
  name             TEXT    NOT NULL,
  type             TEXT    NOT NULL,
  encrypted_api_key TEXT   NOT NULL DEFAULT '',
  base_url         TEXT    NOT NULL,
  default_model    TEXT    NOT NULL,
  is_active        INTEGER NOT NULL,
  models           TEXT    NOT NULL DEFAULT '',
  is_enabled       INTEGER NOT NULL DEFAULT 1,
  use_full_url     INTEGER NOT NULL DEFAULT 0,
  use_response_api INTEGER NOT NULL DEFAULT 0
);

-- ── queries ──
insertProvider:
INSERT INTO ai_providers (id, name, type, encrypted_api_key, base_url, default_model, is_active, models, is_enabled, use_full_url, use_response_api)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- v2-full-takeover P0-2：对齐 Room `@Insert(onConflict = REPLACE)` 语义。
-- 纯 INSERT 在「编辑已存在 Provider」时会抛主键冲突；业务保存路径统一走本查询。
insertOrReplaceProvider:
INSERT OR REPLACE INTO ai_providers (id, name, type, encrypted_api_key, base_url, default_model, is_active, models, is_enabled, use_full_url, use_response_api)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectProviderById:
SELECT * FROM ai_providers WHERE id = ?;

-- P0-2：排序键对齐 Room（ORDER BY id）——V1→V2 切换不得改变 Provider 列表既有顺序，
-- 否则 ensureActiveProvider「自动激活首个」选中的 provider 会变。
selectAllProviders:
SELECT * FROM ai_providers ORDER BY id;

-- P0-2：补 LIMIT 1，与 Room 一致（多行 active 脏数据下行为确定）。
selectActiveProvider:
SELECT * FROM ai_providers WHERE is_active = 1 LIMIT 1;

deactivateAllProviders:
UPDATE ai_providers SET is_active = 0;

deleteProvider:
DELETE FROM ai_providers WHERE id = ?;

-- ── P0-2：补齐 Room 侧列级 setter（缺这些则批 1 无法切换业务）──

activateProvider:
UPDATE ai_providers SET is_active = 1 WHERE id = ?;

setDefaultModel:
UPDATE ai_providers SET default_model = ? WHERE id = ?;

setModels:
UPDATE ai_providers SET models = ? WHERE id = ?;

setProviderEnabled:
UPDATE ai_providers SET is_enabled = ? WHERE id = ?;

updateEncryptedApiKey:
UPDATE ai_providers SET encrypted_api_key = ? WHERE id = ?;

selectProviderCount:
SELECT COUNT(*) FROM ai_providers;

selectActiveProviderCount:
SELECT COUNT(*) FROM ai_providers WHERE is_active = 1;
