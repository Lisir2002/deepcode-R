-- t2i 域 v2 schema（设计文档 §11.5）
-- 生成类：T2iDb / T2iQueries
--
-- v2-full-takeover P2-2：t2i_task 结构对齐 Room T2ITaskEntity（30 列全集），
-- 使 V2 可完整接管任务表读写，业务读源切 V2 后行为与 Room 版完全一致。

CREATE TABLE t2i_task (
  id                  TEXT    NOT NULL PRIMARY KEY,
  session_id          TEXT    NOT NULL,
  message_id          TEXT    NOT NULL DEFAULT '',
  prompt              TEXT    NOT NULL,
  negative_prompt     TEXT    NOT NULL DEFAULT '',
  width               INTEGER NOT NULL DEFAULT 1024,
  height              INTEGER NOT NULL DEFAULT 1024,
  steps               INTEGER NOT NULL DEFAULT 30,
  seed                INTEGER NOT NULL DEFAULT 0,
  hd                  INTEGER NOT NULL DEFAULT 0,
  provider_id         TEXT    NOT NULL,
  model_id            TEXT    NOT NULL,
  provider_ref        TEXT    NOT NULL DEFAULT '',
  endpoint_mode_ref   TEXT    NOT NULL DEFAULT '',
  status              TEXT    NOT NULL DEFAULT 'PENDING',
  image_path          TEXT    NOT NULL DEFAULT '',
  thumbnail_path      TEXT    NOT NULL DEFAULT '',
  remote_task_id      TEXT    NOT NULL DEFAULT '',
  progress_percent    INTEGER NOT NULL DEFAULT 0,
  retry_count         INTEGER NOT NULL DEFAULT 0,
  max_retries         INTEGER NOT NULL DEFAULT 3,
  error_code          TEXT    NOT NULL DEFAULT '',
  error_message       TEXT    NOT NULL DEFAULT '',
  permission_decision TEXT    NOT NULL DEFAULT '',
  quota_deducted_tokens INTEGER NOT NULL DEFAULT 0,
  created_at_ms       INTEGER NOT NULL DEFAULT 0,
  updated_at_ms       INTEGER NOT NULL DEFAULT 0,
  completed_at_ms     INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX idx_t2i_tasks_session_created ON t2i_task (session_id, created_at_ms DESC);
CREATE INDEX idx_t2i_tasks_status ON t2i_task (status);
CREATE INDEX idx_t2i_tasks_message ON t2i_task (message_id);

CREATE TABLE t2i_result (
  id          TEXT    NOT NULL PRIMARY KEY,
  task_id     TEXT    NOT NULL,
  blob_ref    TEXT    NOT NULL,
  seed        INTEGER,
  width       INTEGER,
  height      INTEGER,
  seq         INTEGER NOT NULL,
  FOREIGN KEY (task_id) REFERENCES t2i_task(id)
);
CREATE INDEX t2i_result_task_idx ON t2i_result (task_id);

-- ── 任务查询（对齐 Room T2ITaskDao 全集）──

insertTask:
INSERT INTO t2i_task (id, session_id, message_id, prompt, negative_prompt, width, height, steps, seed, hd, provider_id, model_id, provider_ref, endpoint_mode_ref, status, image_path, thumbnail_path, remote_task_id, progress_percent, retry_count, max_retries, error_code, error_message, permission_decision, quota_deducted_tokens, created_at_ms, updated_at_ms, completed_at_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- P0-2：对齐 Room `@Insert(onConflict = REPLACE)` 语义。
insertOrReplaceTask:
INSERT OR REPLACE INTO t2i_task (id, session_id, message_id, prompt, negative_prompt, width, height, steps, seed, hd, provider_id, model_id, provider_ref, endpoint_mode_ref, status, image_path, thumbnail_path, remote_task_id, progress_percent, retry_count, max_retries, error_code, error_message, permission_decision, quota_deducted_tokens, created_at_ms, updated_at_ms, completed_at_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTaskById:
SELECT * FROM t2i_task WHERE id = ?;

selectTasksBySession:
SELECT * FROM t2i_task WHERE session_id = ? ORDER BY created_at_ms DESC;

selectTaskByMessageId:
SELECT * FROM t2i_task WHERE message_id = ?;

selectAllTasks:
SELECT * FROM t2i_task ORDER BY updated_at_ms DESC;

-- 崩溃恢复扫描：PENDING / RUNNING / PENDING_RETRY 且更新于 cutoff 之前。
selectDanglingTasks:
SELECT * FROM t2i_task WHERE status IN ('PENDING','RUNNING','PENDING_RETRY') AND updated_at_ms < ? ORDER BY updated_at_ms ASC;

updateTaskStatus:
UPDATE t2i_task SET status = ?, updated_at_ms = ? WHERE id = ?;

updateTaskStatusAndProgress:
UPDATE t2i_task SET status = ?, progress_percent = ?, updated_at_ms = ? WHERE id = ?;

markTaskSuccess:
UPDATE t2i_task SET status = 'SUCCESS', image_path = ?, thumbnail_path = ?, progress_percent = 100, completed_at_ms = ?, updated_at_ms = ? WHERE id = ?;

markTaskFailedOrRetry:
UPDATE t2i_task SET status = ?, error_code = ?, error_message = ?, retry_count = ?, updated_at_ms = ? WHERE id = ?;

setTaskRemoteId:
UPDATE t2i_task SET remote_task_id = ?, updated_at_ms = ? WHERE id = ?;

setTaskPermissionDecision:
UPDATE t2i_task SET permission_decision = ?, quota_deducted_tokens = ?, updated_at_ms = ? WHERE id = ?;

deleteTask:
DELETE FROM t2i_task WHERE id = ?;

deleteTasksBySession:
DELETE FROM t2i_task WHERE session_id = ?;

sumDeductedTokensSince:
SELECT COALESCE(SUM(quota_deducted_tokens), 0) FROM t2i_task WHERE created_at_ms >= ? AND status IN ('SUCCESS','FAILED');

sumDeductedTokensForSession:
SELECT COALESCE(SUM(quota_deducted_tokens), 0) FROM t2i_task WHERE session_id = ? AND status IN ('SUCCESS','FAILED');

countSuccessfulImagesSince:
SELECT COUNT(*) FROM t2i_task WHERE created_at_ms >= ? AND status = 'SUCCESS';

insertResult:
INSERT INTO t2i_result (id, task_id, blob_ref, seed, width, height, seq)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectResultsByTask:
SELECT * FROM t2i_result WHERE task_id = ? ORDER BY seq ASC;

-- ── 旧 Room t2i 域补表（阶段 1）──

CREATE TABLE t2i_providers (
  id                 TEXT    NOT NULL PRIMARY KEY,
  name               TEXT    NOT NULL,
  type               TEXT    NOT NULL,
  base_url           TEXT    NOT NULL,
  encrypted_api_key  TEXT    NOT NULL DEFAULT '',
  endpoint_mode      TEXT    NOT NULL DEFAULT 'AUTO',
  is_active          INTEGER NOT NULL DEFAULT 0,
  priority           INTEGER NOT NULL DEFAULT 0,
  is_enabled         INTEGER NOT NULL DEFAULT 1,
  extra_headers_json TEXT    NOT NULL DEFAULT '',
  created_at_ms      INTEGER NOT NULL DEFAULT 0,
  updated_at_ms      INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX t2i_providers_active_idx ON t2i_providers (is_active);
CREATE INDEX t2i_providers_priority_idx ON t2i_providers (priority DESC);

CREATE TABLE t2i_provider_models (
  id                   TEXT    NOT NULL PRIMARY KEY,
  provider_id          TEXT    NOT NULL,
  model_id             TEXT    NOT NULL,
  display_name         TEXT    NOT NULL DEFAULT '',
  supports_hd          INTEGER NOT NULL DEFAULT 0,
  supports_inpaint     INTEGER NOT NULL DEFAULT 0,
  default_width        INTEGER NOT NULL DEFAULT 1024,
  default_height       INTEGER NOT NULL DEFAULT 1024,
  max_steps            INTEGER NOT NULL DEFAULT 50,
  default_steps        INTEGER NOT NULL DEFAULT 30,
  cost_per_image_tokens INTEGER NOT NULL DEFAULT 0,
  created_at_ms        INTEGER NOT NULL DEFAULT 0,
  updated_at_ms        INTEGER NOT NULL DEFAULT 0,
  UNIQUE (provider_id, model_id),
  FOREIGN KEY (provider_id) REFERENCES t2i_providers(id)
);
CREATE INDEX t2i_provider_models_provider_idx ON t2i_provider_models (provider_id);

-- ── queries ──
insertT2iProvider:
INSERT INTO t2i_providers (id, name, type, base_url, encrypted_api_key, endpoint_mode, is_active, priority, is_enabled, extra_headers_json, created_at_ms, updated_at_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertOrReplaceT2iProvider:
INSERT OR REPLACE INTO t2i_providers (id, name, type, base_url, encrypted_api_key, endpoint_mode, is_active, priority, is_enabled, extra_headers_json, created_at_ms, updated_at_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectT2iProviderById:
SELECT * FROM t2i_providers WHERE id = ?;

selectAllT2iProviders:
SELECT * FROM t2i_providers ORDER BY priority DESC;

selectActiveT2iProvider:
SELECT * FROM t2i_providers WHERE is_active = 1 LIMIT 1;

deactivateAllT2iProviders:
UPDATE t2i_providers SET is_active = 0;

setT2iProviderActive:
UPDATE t2i_providers SET is_active = 1 WHERE id = ?;

setT2iProviderEnabled:
UPDATE t2i_providers SET is_enabled = ?, updated_at_ms = ? WHERE id = ?;

setT2iProviderEndpointMode:
UPDATE t2i_providers SET endpoint_mode = ?, updated_at_ms = ? WHERE id = ?;

updateT2iProviderEncryptedApiKey:
UPDATE t2i_providers SET encrypted_api_key = ?, updated_at_ms = ? WHERE id = ?;

deleteT2iProvider:
DELETE FROM t2i_providers WHERE id = ?;

insertT2iProviderModel:
INSERT INTO t2i_provider_models (id, provider_id, model_id, display_name, supports_hd, supports_inpaint, default_width, default_height, max_steps, default_steps, cost_per_image_tokens, created_at_ms, updated_at_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertOrReplaceT2iProviderModel:
INSERT OR REPLACE INTO t2i_provider_models (id, provider_id, model_id, display_name, supports_hd, supports_inpaint, default_width, default_height, max_steps, default_steps, cost_per_image_tokens, created_at_ms, updated_at_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectT2iModelsByProvider:
SELECT * FROM t2i_provider_models WHERE provider_id = ? ORDER BY model_id ASC;

deleteT2iProviderModels:
DELETE FROM t2i_provider_models WHERE provider_id = ?;
