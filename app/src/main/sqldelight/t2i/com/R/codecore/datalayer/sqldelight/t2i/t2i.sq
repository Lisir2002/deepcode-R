-- t2i 域 v1 schema（设计文档 §11.5）
-- 生成类：T2iDb / T2iQueries

CREATE TABLE t2i_task (
  id          TEXT    NOT NULL PRIMARY KEY,
  prompt      TEXT    NOT NULL,
  params_json TEXT,
  status      TEXT    NOT NULL,
  created_at  INTEGER NOT NULL,
  updated_at  INTEGER NOT NULL
);

CREATE TABLE t2i_result (
  id          TEXT    NOT NULL PRIMARY KEY,
  task_id     TEXT    NOT NULL,
  blob_ref    TEXT    NOT NULL,
  seed        INTEGER,
  width       INTEGER,
  height      INTEGER,
  seq         INTEGER NOT NULL,
  FOREIGN KEY (task_id) REFERENCES t2i_task(id)
);
CREATE INDEX t2i_result_task_idx ON t2i_result (task_id);

-- ── queries ──
insertTask:
INSERT INTO t2i_task (id, prompt, params_json, status, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?);

updateTaskStatus:
UPDATE t2i_task SET status = ?, updated_at = ? WHERE id = ?;

selectTaskById:
SELECT * FROM t2i_task WHERE id = ?;

selectAllTasks:
SELECT * FROM t2i_task ORDER BY updated_at DESC;

insertResult:
INSERT INTO t2i_result (id, task_id, blob_ref, seed, width, height, seq)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectResultsByTask:
SELECT * FROM t2i_result WHERE task_id = ? ORDER BY seq ASC;

deleteTask:
DELETE FROM t2i_task WHERE id = ?;

-- ── 旧 Room t2i 域补表（阶段 1）──

CREATE TABLE t2i_providers (
  id                 TEXT    NOT NULL PRIMARY KEY,
  name               TEXT    NOT NULL,
  type               TEXT    NOT NULL,
  base_url           TEXT    NOT NULL,
  encrypted_api_key  TEXT    NOT NULL DEFAULT '',
  endpoint_mode      TEXT    NOT NULL DEFAULT 'AUTO',
  is_active          INTEGER NOT NULL DEFAULT 0,
  priority           INTEGER NOT NULL DEFAULT 0,
  is_enabled         INTEGER NOT NULL DEFAULT 1,
  extra_headers_json TEXT    NOT NULL DEFAULT '',
  created_at_ms      INTEGER NOT NULL DEFAULT 0,
  updated_at_ms      INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX t2i_providers_active_idx ON t2i_providers (is_active);
CREATE INDEX t2i_providers_priority_idx ON t2i_providers (priority DESC);

CREATE TABLE t2i_provider_models (
  id                   TEXT    NOT NULL PRIMARY KEY,
  provider_id          TEXT    NOT NULL,
  model_id             TEXT    NOT NULL,
  display_name         TEXT    NOT NULL DEFAULT '',
  supports_hd          INTEGER NOT NULL DEFAULT 0,
  supports_inpaint     INTEGER NOT NULL DEFAULT 0,
  default_width        INTEGER NOT NULL DEFAULT 1024,
  default_height       INTEGER NOT NULL DEFAULT 1024,
  max_steps            INTEGER NOT NULL DEFAULT 50,
  default_steps        INTEGER NOT NULL DEFAULT 30,
  cost_per_image_tokens INTEGER NOT NULL DEFAULT 0,
  created_at_ms        INTEGER NOT NULL DEFAULT 0,
  updated_at_ms        INTEGER NOT NULL DEFAULT 0,
  UNIQUE (provider_id, model_id),
  FOREIGN KEY (provider_id) REFERENCES t2i_providers(id)
);
CREATE INDEX t2i_provider_models_provider_idx ON t2i_provider_models (provider_id);

-- ── queries ──
insertT2iProvider:
INSERT INTO t2i_providers (id, name, type, base_url, encrypted_api_key, endpoint_mode, is_active, priority, is_enabled, extra_headers_json, created_at_ms, updated_at_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectT2iProviderById:
SELECT * FROM t2i_providers WHERE id = ?;

selectAllT2iProviders:
SELECT * FROM t2i_providers ORDER BY priority DESC;

selectActiveT2iProvider:
SELECT * FROM t2i_providers WHERE is_active = 1 LIMIT 1;

deactivateAllT2iProviders:
UPDATE t2i_providers SET is_active = 0;

deleteT2iProvider:
DELETE FROM t2i_providers WHERE id = ?;

insertT2iProviderModel:
INSERT INTO t2i_provider_models (id, provider_id, model_id, display_name, supports_hd, supports_inpaint, default_width, default_height, max_steps, default_steps, cost_per_image_tokens, created_at_ms, updated_at_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectT2iModelsByProvider:
SELECT * FROM t2i_provider_models WHERE provider_id = ? ORDER BY model_id ASC;

deleteT2iProviderModels:
DELETE FROM t2i_provider_models WHERE provider_id = ?;
