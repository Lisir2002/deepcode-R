-- credentials 域 v1 schema（设计文档 §11.2）
-- 生成类：CredentialsDb / CredentialsQueries

CREATE TABLE cred_connection (
  id           TEXT    NOT NULL PRIMARY KEY,
  name         TEXT    NOT NULL,
  type         TEXT    NOT NULL,
  host         TEXT    NOT NULL,
  port         INTEGER NOT NULL,
  username     TEXT,
  auth_type    TEXT    NOT NULL,
  options_json TEXT,
  created_at   INTEGER NOT NULL
);

CREATE TABLE cred_secret (
  id            TEXT    NOT NULL PRIMARY KEY,
  connection_id TEXT    NOT NULL,
  kind          TEXT    NOT NULL,
  value         TEXT    NOT NULL,
  FOREIGN KEY (connection_id) REFERENCES cred_connection(id)
);
CREATE INDEX cred_secret_conn_idx ON cred_secret (connection_id);

-- ── queries ──
insertConnection:
INSERT INTO cred_connection (id, name, type, host, port, username, auth_type, options_json, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectConnectionById:
SELECT * FROM cred_connection WHERE id = ?;

selectAllConnections:
SELECT * FROM cred_connection ORDER BY created_at DESC;

deleteConnection:
DELETE FROM cred_connection WHERE id = ?;

insertSecret:
INSERT INTO cred_secret (id, connection_id, kind, value)
VALUES (?, ?, ?, ?);

selectSecretsByConnection:
SELECT * FROM cred_secret WHERE connection_id = ?;

deleteSecretByConnection:
DELETE FROM cred_secret WHERE connection_id = ?;

-- ── 旧 Room credentials 域补表（阶段 1）──

CREATE TABLE git_credentials (
  id              TEXT    NOT NULL PRIMARY KEY,
  host            TEXT    NOT NULL,
  username        TEXT    NOT NULL,
  encrypted_token TEXT    NOT NULL DEFAULT '',
  label           TEXT    NOT NULL DEFAULT '',
  is_default      INTEGER NOT NULL DEFAULT 0,
  created_at_ms   INTEGER NOT NULL DEFAULT 0,
  updated_at_ms   INTEGER NOT NULL DEFAULT 0
);

-- ── queries ──
insertGitCredential:
INSERT INTO git_credentials (id, host, username, encrypted_token, label, is_default, created_at_ms, updated_at_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectGitCredentialById:
SELECT * FROM git_credentials WHERE id = ?;

selectAllGitCredentials:
SELECT * FROM git_credentials ORDER BY host ASC;

selectDefaultGitCredential:
SELECT * FROM git_credentials WHERE is_default = 1 LIMIT 1;

deleteGitCredential:
DELETE FROM git_credentials WHERE id = ?;
