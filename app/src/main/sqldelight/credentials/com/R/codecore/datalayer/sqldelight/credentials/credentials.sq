-- credentials 域 v1 schema（设计文档 §11.2）
-- 生成类：CredentialsDb / CredentialsQueries

CREATE TABLE cred_connection (
  id           TEXT    NOT NULL PRIMARY KEY,
  name         TEXT    NOT NULL,
  type         TEXT    NOT NULL,
  host         TEXT    NOT NULL,
  port         INTEGER NOT NULL,
  username     TEXT,
  auth_type    TEXT    NOT NULL,
  options_json TEXT,
  created_at   INTEGER NOT NULL
);

CREATE TABLE cred_secret (
  id            TEXT    NOT NULL PRIMARY KEY,
  connection_id TEXT    NOT NULL,
  kind          TEXT    NOT NULL,
  value         TEXT    NOT NULL,
  FOREIGN KEY (connection_id) REFERENCES cred_connection(id)
);
CREATE INDEX cred_secret_conn_idx ON cred_secret (connection_id);

-- ── queries ──
insertConnection:
INSERT INTO cred_connection (id, name, type, host, port, username, auth_type, options_json, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectConnectionById:
SELECT * FROM cred_connection WHERE id = ?;

selectAllConnections:
SELECT * FROM cred_connection ORDER BY created_at DESC;

deleteConnection:
DELETE FROM cred_connection WHERE id = ?;

insertSecret:
INSERT INTO cred_secret (id, connection_id, kind, value)
VALUES (?, ?, ?, ?);

selectSecretsByConnection:
SELECT * FROM cred_secret WHERE connection_id = ?;

deleteSecretByConnection:
DELETE FROM cred_secret WHERE connection_id = ?;
