<?xml version="1.0" encoding="utf-8"?>
<!--
  R-DeepCode Launcher Icon 前景矢量 v2 — 对话气泡 + 代码符号 </> + 蓝紫渐变
  viewBox = 108×108，自适应图标 foreground 规范。
  构图：中央圆角对话气泡（左下尾巴），内嵌白色 </> 代码符号。
  配色：气泡渐变 #165DFF → #7B61FF（135°），代码符号 #FFFFFF，背景透明。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 对话气泡主体（圆角矩形 + 左下尾巴），渐变填充 -->
    <path
        android:pathData="M33,24 L75,24 A11,11 0 0 1 86,35 L86,65 A11,11 0 0 1 75,76 L42,76 L36,86 L33,76 L33,35 A11,11 0 0 1 33,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="22"
                android:startY="24"
                android:endX="86"
                android:endY="84"
                android:startColor="#FF165DFF"
                android:endColor="#FF7B61FF" />
        </aapt:attr>
    </path>

    <!-- 代码符号 </> ：白色 -->
    <!-- < 左尖括号 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M44,36 L38,46 L44,56 L41,56 L36,46 L41,36 Z" />
    <!-- > 右尖括号 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M64,36 L70,46 L64,56 L67,56 L72,46 L67,36 Z" />
    <!-- / 中间斜线 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M56,34 L53,34 L48,58 L51,58 Z" />
</vector>
