<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        AI provider Base URLs are user-configurable and may point at plain-HTTP
        endpoints (self-hosted proxies, LAN servers). Therefore cleartext traffic
        is permitted globally.

        Security note: API keys sent over HTTP are transmitted in plaintext and
        can be intercepted by anyone on the same network. Users should use HTTPS
        endpoints whenever possible, especially when connecting over the internet.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>